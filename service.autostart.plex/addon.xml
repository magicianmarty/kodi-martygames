<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.autostart.plex" name="Autostart Plex" version="1.0.0" provider-name="local">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="script.plexmod"/>
  </requires>
  <extension point="xbmc.service" library="service.py"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Launch Plex (PM4K) on startup</summary>
    <description lang="en_GB">Boots the box straight into the Plex for Kodi UI once the GUI is ready.</description>
    <platform>all</platform>
    <license>MIT</license>
  </extension>
</addon>
