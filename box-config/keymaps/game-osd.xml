<?xml version="1.0" encoding="UTF-8"?>
<!-- The in-game OSD (window 10822) has no section in Kodi's joystick.xml, and
     while a game is running the d-pad is still being consumed by the emulator,
     so navigation never reaches the menu. Bind it explicitly for the OSD and
     its sub-dialogs. -->
<keymap>
  <GameOSD>
    <joystick profile="game.controller.default">
      <up>Up</up>
      <down>Down</down>
      <left>Left</left>
      <right>Right</right>
      <leftstick direction="up">Up</leftstick>
      <leftstick direction="down">Down</leftstick>
      <leftstick direction="left">Left</leftstick>
      <leftstick direction="right">Right</leftstick>
      <a>Select</a>
      <b>Back</b>
      <guide>Back</guide>
    </joystick>
  </GameOSD>
  <GameControllers>
    <joystick profile="game.controller.default">
      <up>Up</up>
      <down>Down</down>
      <left>Left</left>
      <right>Right</right>
      <a>Select</a>
      <b>Back</b>
    </joystick>
  </GameControllers>
  <GameSaves>
    <joystick profile="game.controller.default">
      <up>Up</up>
      <down>Down</down>
      <left>Left</left>
      <right>Right</right>
      <a>Select</a>
      <b>Back</b>
    </joystick>
  </GameSaves>
</keymap>
